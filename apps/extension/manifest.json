{
  "manifest_version": 3,
  "name": "PostFlow",
  "version": "0.1.0",
  "description": "PostFlow Facebook Groups POC",
  "permissions": [
    "storage",
    "tabs",
    "alarms",
    "activeTab"
  ],
  "host_permissions": [
    "https://www.facebook.com/*",
    "https://api.fitcure.online/*",
    "https://fitcure.online/*",
    "http://localhost:8000/*",
    "http://localhost:3000/*"
  ],
  "background": {
    "service_worker": "dist/background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "dist/popup/popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://www.facebook.com/*"],
      "js": [
        "dist/posting-config.js",
        "dist/post-tracking/types.js",
        "dist/post-tracking/detect-pending-approval.js",
        "dist/post-tracking/find-published-post.js",
        "dist/post-tracking/find-pending-published-post.js",
        "dist/post-tracking/parse-facebook-count.js",
        "dist/post-tracking/extract-engagement.js",
        "dist/post-tracking/wait-for-post-submission-result.js",
        "dist/content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.facebook.com/*"],
      "js": ["dist/facebook-session.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://fitcure.online/*",
        "https://www.fitcure.online/*",
        "http://localhost:3000/*",
        "http://127.0.0.1:3000/*"
      ],
      "js": ["dist/postflow-content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["dist/graphql-spy.js"],
      "matches": ["https://www.facebook.com/*"]
    }
  ]
}
